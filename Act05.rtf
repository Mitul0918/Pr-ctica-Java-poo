\f0\fs24 \cf0 public class Ordenamiento\{\
    public static void ordenamientoPorInsercion(int[] lista,int n)\{\
        for(int i=1;i<n;i++)\{\
            int clave=lista [i];\
            int j=i-1;\
            while(j>=0 && lista[j]>clave)\{\
                lista[j+1]=lista[j];\
                j=j-1;\
            \}\
            lista[j+1]=clave;\
        \}\
    \}\
    public static void main(String [] args)\{\
        int[] miLista=\{905,210,550,102,443\};\
        int n=5;\
        ordenamientoPorInsercion(miLista,n);\
        for(int num:miLista)\{\
            System.out.println(num+" ");\
        \}\
    \}\
\}}